# ==============================================================================
# BK PARKING MVP - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and adjust values according to your local environment
# ==============================================================================

# Application Port
SERVER_PORT=8080

# Spring Profiles Active (dev: in-memory H2 DB | postgres: local/docker postgres | prod: production)
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (Used when profile is postgres or prod)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bk_parking
DB_USER=bkparking
DB_PASSWORD=bkparking123

# Security & JWT Configuration
# Note: In production, generate a cryptographically strong 256-bit+ secret key
JWT_SECRET=BkParkingMvpSecretKeyForJwtSigning2026VeryLongAndSecureKey123456
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated for Frontend development)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
